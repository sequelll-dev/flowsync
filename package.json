{
  "name": "flowsync",
  "description": "FlowSync — personal productivity and task management.",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write src scripts \"*.{json,html,ts}\" README.md",
    "format:check": "prettier --check src scripts \"*.{json,html,ts}\" README.md"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
